{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの権限。ファイルの読み書きはアプリ独自のコマンド（画像だけ）で行い、fs プラグインは使わない",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
