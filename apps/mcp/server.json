{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hosshan/harie",
  "title": "Harie",
  "description": "Annotate screenshots for user guides. Saved as plain JPEG/PNG whose annotations stay editable.",
  "websiteUrl": "https://harie.studio/en/",
  "repository": {
    "url": "https://github.com/hosshan/harie",
    "source": "github",
    "subfolder": "apps/mcp"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@harie/mcp",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "named",
          "name": "--root",
          "description": "Folder the server may read and write images in (default: current directory)",
          "format": "filepath",
          "isRequired": false
        }
      ]
    }
  ]
}
