# 評価（pnpm --filter @harie/ai eval）で使う認証。packages/ai/.env にコピーして値を入れる。
# .env は .gitignore 済み。この .env.example には値を書かないこと。

# Claude のプラン（Pro / Max など）で回すとき。`claude setup-token` で作った sk-ant-oat...
CLAUDE_CODE_OAUTH_TOKEN=

# Claude API の従量課金で回すとき（設定するとこちらが優先される）
# ANTHROPIC_API_KEY=

# モデルを変えるとき（既定は claude-opus-5-5）
# HARIE_AI_MODEL=claude-sonnet-5-5
