{
  "name": "@anoi/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Anoi（注釈を再編集できる JPEG/PNG）を読み書きするローカル MCP サーバー",
  "type": "module",
  "bin": {
    "anoi-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.mjs --banner:js=\"#!/usr/bin/env node\" --external:@modelcontextprotocol/sdk --external:zod --external:@resvg/resvg-wasm --external:@jsquash/jpeg && node scripts/copy-assets.mjs",
    "start": "node dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anoi/format": "workspace:*",
    "@anoi/model": "workspace:*",
    "@anoi/render": "workspace:*",
    "@expo-google-fonts/noto-sans-jp": "^0.4.4",
    "esbuild": "^0.28.2"
  }
}
