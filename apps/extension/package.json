{
  "name": "@harie/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "HARIE_E2E=1 wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc -p tsconfig.json && tsc -p tsconfig.e2e.json",
    "e2e": "pnpm build && pnpm build:e2e && playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@harie/ai": "workspace:*",
    "@harie/editor": "workspace:*",
    "@harie/model": "workspace:*",
    "@harie/web": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@harie/format": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "wxt": "~0.21.4"
  }
}
