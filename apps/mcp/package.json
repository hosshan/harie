{
  "name": "@harie/mcp",
  "version": "0.4.0",
  "mcpName": "io.github.hosshan/harie",
  "description": "Local MCP server for Harie: annotate screenshots for user guides with boxes, arrows and callouts, saved as plain JPEG/PNG that stay re-editable",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "screenshot",
    "annotation",
    "image-annotation",
    "user-guide",
    "documentation",
    "jpeg",
    "png",
    "pii",
    "harie"
  ],
  "homepage": "https://github.com/hosshan/harie/tree/main/apps/mcp#readme",
  "bugs": "https://github.com/hosshan/harie/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hosshan/harie.git",
    "directory": "apps/mcp"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "harie-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.mjs --banner:js=\"#!/usr/bin/env node\" --external:@modelcontextprotocol/sdk --external:zod --external:@resvg/resvg-wasm --external:@jsquash/jpeg && node scripts/copy-assets.mjs",
    "start": "node dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-sans-jp": "^0.4.4",
    "@harie/ai": "workspace:*",
    "@harie/format": "workspace:*",
    "@harie/model": "workspace:*",
    "@harie/render": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
